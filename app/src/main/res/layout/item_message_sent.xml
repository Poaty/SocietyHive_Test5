<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="end"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <!-- pushed in 64dp from the left so it sits clearly on the right — tried 48 first and it looked too centered -->
    <TextView
        android:id="@+id/tvMessageSent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="64dp"
        android:layout_marginEnd="10dp"
        android:background="@drawable/bg_bubble_sent"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="11dp"
        android:paddingBottom="11dp"
        android:text="Hello."
        android:textColor="#1E1E1E"
        android:textSize="16sp"
        android:elevation="2dp"
        tools:text="sounds good for Thursday" />
</LinearLayout>
