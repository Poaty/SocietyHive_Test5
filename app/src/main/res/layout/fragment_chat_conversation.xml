<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- full-width banner header — went with this instead of the thin accent + text strip, looks much better with custom society colours -->
    <FrameLayout
        android:id="@+id/layoutChatHeader"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:background="@drawable/bg_chat_header_banner"
        android:clipToOutline="true"
        android:elevation="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <View
            android:id="@+id/viewChatHeaderAccent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/button1" />

        <TextView
            android:id="@+id/tvChatHeaderTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|start"
            android:paddingStart="22dp"
            android:paddingEnd="16dp"
            android:text="Group Chat"
            android:textSize="20sp"
            tools:text="Computing Society"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:shadowColor="#55000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="2" />
    </FrameLayout>

    <!-- 0dp height so ConstraintLayout stretches the message list to fill exactly the space between header and input -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMessages"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:clipToPadding="false"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        app:layout_constraintTop_toBottomOf="@id/layoutChatHeader"
        app:layout_constraintBottom_toTopOf="@id/cardMessageInput"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- FrameLayout + drawable instead of MaterialCardView so the corners can be asymmetric like the bubbles above — elevation still set so it lifts off -->
    <FrameLayout
        android:id="@+id/cardMessageInput"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_message_input"
        android:elevation="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_add"
                app:tint="#1E1E1E" />

            <EditText
                android:id="@+id/etMessage"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="Text Message"
                android:inputType="textMultiLine"
                android:maxLines="4"
                android:textColor="#1E1E1E"
                android:textColorHint="#88666666" />

            <ImageView
                android:id="@+id/btnSendMessage"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_send"
                app:tint="@color/button1" />

        </LinearLayout>
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
