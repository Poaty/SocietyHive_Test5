<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorPrimaryContainer">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp"
        android:paddingBottom="9dp"
        android:text="Browse Societies"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="?attr/colorOnPrimaryContainer" />

    <!-- alpha 0.7 on the subtitle so it sits below the heading visually without needing a different colour -->
    <TextView
        android:id="@+id/tvSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp"
        android:text="Request to join a society below."
        android:textSize="13sp"
        android:textColor="?attr/colorOnPrimaryContainer"
        android:alpha="0.7" />

    <!-- both the list and the empty state get weight=1 so only one fills the space at a time -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvBrowseSocieties"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp"
        android:clipToPadding="false" />

    <TextView
        android:id="@+id/tvEmpty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="No societies available to join."
        android:textSize="14sp"
        android:textColor="?attr/colorOnPrimaryContainer"
        android:alpha="0.6"
        android:visibility="gone" />

</LinearLayout>
